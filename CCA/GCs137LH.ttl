        <https://www.wikidata.org/entity/Q165> ;
    iop:hasProperty 
        <http://qudt.org/vocab/quantitykind/MassicActivity> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
             rdfs:label "origin: La Hague plant" ;
             iop:constrains <https://www.wikidata.org/entity/Q1154826> ;
        ] .

