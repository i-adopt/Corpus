@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/challenge/> .
@prefix iopp: <https://w3id.org/iadopt/pattern/> .
@prefix patt: <http://example.org/iadopt/pattern> .

ex:PersWelfare
    a 
        iop:Variable ;
    rdfs:label 
        "Number of persons receiving welfare in a statistical unit" ;
    rdfs:comment 
        """number of persons receiving welfare in a statistical unit which is defined as a grouping of homogeneous neighboring building blocks""" ;
    iop:hasObjectOfInterest 
        <https://www.wikidata.org/entity/Q215627> ;
    iop:hasMatrix 
        <https://www.wikidata.org/entity/Q702492> ;
    iop:hasProperty 
        <https://qudt.org/vocab/quantitykind/Count> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
             rdfs:label "condition: receiving welfare" ;
             iop:constrains <https://www.wikidata.org/entity/Q215627> ;
        ] ,
        [ a iop:Constraint ;
             rdfs:label "condition: registered as residents in a statistical unit" ;
             iop:constrains <https://www.wikidata.org/entity/Q215627> ;
        ] .

<https://www.wikidata.org/entity/Q215627>
    a 
        iop:Entity ;
    rdfs:label 
        "person" .

<https://www.wikidata.org/entity/Q702492>
    a 
        iop:Entity ;
    rdfs:label 
        "urban area" .

<https://qudt.org/vocab/quantitykind/Count>
    a 
        iop:Property ;
    rdfs:label 
        "count" .
