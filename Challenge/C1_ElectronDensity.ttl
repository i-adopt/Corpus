@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/challenge/> .

ex:C1
    a 
        iop:Variable ;
    rdfs:label 
        "Electron density in the solar wind" ;
    rdfs:comment 
        """Density (particle per cm3) of electrons measured in the Solar Wind.""" ;
    iop:hasObjectOfInterest 
        <http://purl.obolibrary.org/obo/CHEBI_10545> ;
    iop:hasMatrix 
        <https://gcmd.earthdata.nasa.gov/kms/concept/5d290bd8-049b-4002-86c8-8acba563d0e1> ;
    iop:hasProperty 
        _:b0 .

<http://purl.obolibrary.org/obo/CHEBI_10545>
    a 
        iop:Entity ;
    rdfs:label 
        "electron" .

<https://gcmd.earthdata.nasa.gov/kms/concept/5d290bd8-049b-4002-86c8-8acba563d0e1>
    a 
        iop:Entity ;
    rdfs:label 
        "solar wind" .

_:b0
    a 
        iop:Property ;
    rdfs:label 
        "volumic number density" .
